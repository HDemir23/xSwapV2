# Database
DATABASE_URL="postgresql://user:password@localhost:5432/xswap?schema=public"

# Kuru API
KURU_API_URL="https://ws.kuru.io"

# Fee Collection
FEE_WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
PLATFORM_FEE_BPS=50

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Monad Network
MONAD_RPC_URL="https://rpc.monad.xyz"
MONAD_CHAIN_ID=143

# Kuru Contracts
KURU_ROUTER_ADDRESS="0xd651346d7c789536ebf06dc72aE3C8502cd695CC"
KURU_FLOW_ENTRYPOINT="0xb3e6778480b2E488385E8205eA05E20060B813cb"
KURU_MARGIN_ACCOUNT="0x2A68ba1833cDf93fa9Da1EEbd7F46242aD8E90c5"

# Router deployment block (to be found from explorer)
KURU_ROUTER_DEPLOYMENT_BLOCK=0

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_RPM=60
BOT_RATE_LIMIT_RPM=100

# Server
PORT=3001
NODE_ENV=development
